+/* wps_nintendo_ie: lay out Beacon/Probe Response elements like a real Wii U
+ * pairing AP (dvdhrm's 2013 capture): no Supported Operating Classes or
+ * Extended Capabilities, and WMM last, after the vendor elements. */
+static bool hostapd_nin_layout(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_TENDONIN
+	return hapd->conf->wps_nintendo_ie;
+#else /* CONFIG_TENDONIN */
+	return false;
+#endif /* CONFIG_TENDONIN */
+}
+
+
+/* HT Capabilities + HT Operation exactly as the captured console sends them:
+ * caps 0x001c (HT20, SM PS disabled, RX Greenfield), A-MPDU 0x19 (16383 bytes,
+ * 8 usec), RX MCS 0-15, TX MCS undefined; HT op: primary channel, RIFS=1,
+ * everything else 0. Written as bytes: hostapd won't configure [GF] on a driver
+ * without Greenfield, and the beacon only has to look like the console's. */
+static u8 * hostapd_eid_nin_ht(struct hostapd_data *hapd, u8 *eid)
+{
+	*eid++ = WLAN_EID_HT_CAP;
+	*eid++ = 26;
+	os_memset(eid, 0, 26);
+	eid[0] = 0x1c;
+	eid[2] = 0x19;
+	eid[3] = 0xff;
+	eid[4] = 0xff;
+	eid += 26;
+	*eid++ = WLAN_EID_HT_OPERATION;
+	*eid++ = 22;
+	os_memset(eid, 0, 22);
+	eid[0] = hapd->iconf->channel;
+	eid[1] = 0x08;
+	eid += 22;
+	return eid;
+}
