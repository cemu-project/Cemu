+#ifdef CONFIG_TENDONIN
+/* Config Methods as a real Wii U pairing AP advertises them: 0x0084 (Push Button
+ * + Label), WPS 1.0 style (dvdhrm's 2013 Probe Response capture). */
+#define WPS_NIN_CONFIG_METHODS 0x0084
+
+static struct wpabuf * wps_nin_prepend_f5(struct wpabuf *ie)
+{
+	static const u8 f5[] = { WLAN_EID_VENDOR_SPECIFIC, 5,
+				 0xa4, 0xc0, 0xe1, 0xf5, 0x00 };
+	struct wpabuf *out;
+
+	if (!ie)
+		return NULL;
+	out = wpabuf_alloc(sizeof(f5) + wpabuf_len(ie));
+	if (out) {
+		wpabuf_put_data(out, f5, sizeof(f5));
+		wpabuf_put_buf(out, ie);
+	}
+	wpabuf_free(ie);
+	return out;
+}
+
+
+static int wps_build_nin_methods(struct wpabuf *msg, u16 attr)
+{
+	wpabuf_put_be16(msg, attr);
+	wpabuf_put_be16(msg, 2);
+	wpabuf_put_be16(msg, WPS_NIN_CONFIG_METHODS);
+	return 0;
+}
+
+
+/* WPS attributes in the order and form of a real Wii U pairing AP's Probe
+ * Response (no WFA extension: no Version2, no AuthorizedMACs). */
+static int wps_build_nin_attrs(struct wps_registrar *reg, struct wpabuf *msg)
+{
+	if (wps_build_version(msg) ||
+	    wps_build_wps_state(reg->wps, msg) ||
+	    wps_build_ap_setup_locked(reg->wps, msg) ||
+	    wps_build_selected_registrar(reg, msg) ||
+	    wps_build_sel_reg_dev_password_id(reg, msg) ||
+	    (reg->sel_reg_union &&
+	     wps_build_nin_methods(msg,
+				   ATTR_SELECTED_REGISTRAR_CONFIG_METHODS)) ||
+	    wps_build_resp_type(msg, WPS_RESP_AP) ||
+	    wps_build_uuid_e(msg, reg->wps->uuid) ||
+	    wps_build_device_attrs(&reg->wps->dev, msg) ||
+	    wps_build_nin_methods(msg, ATTR_CONFIG_METHODS))
+		return -1;
+	return 0;
+}
+
+
+/* The captured console data is from a Probe Response; its Beacon is unknown.
+ * The GamePad scans passively in sync mode (it sent no Probe Requests to our
+ * AP), so it only ever sees the Beacon: send the full set there too, as
+ * Broadcom WPS APs commonly do. */
+static int wps_build_nin_ies(struct wps_registrar *reg, struct wpabuf *beacon,
+			     struct wpabuf *probe)
+{
+	wpa_printf(MSG_DEBUG, "WPS: Build Wii U style Beacon/Probe Response IEs");
+	if (wps_build_nin_attrs(reg, beacon) ||
+	    wps_build_nin_attrs(reg, probe))
+		return -1;
+	return 0;
+}
+#endif /* CONFIG_TENDONIN */
+
+
